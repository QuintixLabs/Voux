{
  "name": "voux",
  "version": "2.4.0",
  "description": "A self hosted view counter for blogs and websites with a built in dashboard.",
  "main": "src/server.js",
  "scripts": {
    "dev": "nodemon --ignore data/backups --ignore data/backups/** src/server.js",
    "start": "node src/server.js",
    "clear-hits": "node scripts/clearHits.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier \"public/js/**/*.js\" \"src/**/*.js\" \"scripts/**/*.js\" --write",
    "format:check": "prettier \"public/js/**/*.js\" \"src/**/*.js\" \"scripts/**/*.js\" --check"
  },
  "keywords": [],
  "author": "",
  "license": "GPL-3.0",
  "dependencies": {
    "better-sqlite3": "^12.4.1",
    "body-parser": "^2.3.0",
    "dotenv": "^17.2.3",
    "express": "^5.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "eslint": "^9.39.4",
    "globals": "^17.6.0",
    "nodemon": "^3.1.10",
    "prettier": "^3.8.3"
  }
}
